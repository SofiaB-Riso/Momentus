# SQLite: o arquivo fica em backend/instance/momentus.db.
DATABASE_URL=sqlite:///momentus.db
# Desenvolvimento local: a aplicação gera um segredo exclusivo da instalação.
# Em produção, preencha com pelo menos 32 caracteres aleatórios e mantenha privado.
SECRET_KEY=
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
FLASK_DEBUG=False
PORT=5000
# Opcional: busca externa de fornecedores e espaços.
GOOGLE_MAPS_API_KEY=
# MySQL: instale database/create_database.sql antes de usar.
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost/momentus_db
# UPLOAD_FOLDER=/caminho/absoluto/para/uploads

# Recuperação de senha por e-mail. Nenhuma mensagem é enviada sem configurar.
PUBLIC_BASE_URL=http://127.0.0.1:5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=momentus.projeto@gmail.com
SMTP_USERNAME=momentus.projeto@gmail.com
SMTP_PASSWORD=
# Dados acadêmicos aprovados pelo grupo. Para publicar, use contatos reais e false.
PRIVACY_DEMO=true
PRIVACY_CONTROLLER=Sofia Braga Riso
PRIVACY_OFFICER=Sofie Cirino e Castro
PRIVACY_EMAIL=momentus@momentus.com
PRIVACY_PHONE=+55 31 99999-9999
# Somente atrás de um proxy próprio e confiável (ver docs/OPERACAO.md).
TRUST_PROXY_HEADERS=false
BIND_HOST=127.0.0.1
WSGI_THREADS=32
