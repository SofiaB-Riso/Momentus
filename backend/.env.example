# SQLite: o arquivo fica em backend/instance/momentus.db.
DATABASE_URL=sqlite:///momentus.db
# Substitua por uma chave aleatória própria.
SECRET_KEY=troque-por-uma-chave-aleatoria
FLASK_DEBUG=False
PORT=5000
# Opcional: busca externa de fornecedores e espaços.
GOOGLE_MAPS_API_KEY=
